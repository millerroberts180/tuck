# Tuck's identity for builds, read by scripts/build-app.sh and scripts/release.sh. This is the one place
# it is set: both scripts stamp it on the bundle's copy of Info.plist, so local and release builds match.
# Support/Info.plist carries the same values only so it is a complete plist on its own; every build
# overwrites them from here. Shell syntax: the scripts source this file.

# The final bundle ID belongs on a domain I control. Until it is chosen, scripts/release.sh
# refuses a signed build while this contains "prototype". Changing it gives Tuck a new identity: anyone
# already running Tuck grants Accessibility again and starts with default settings, while the library in
# ~/Library/Application Support/Tuck carries over. See docs/release.md.
BUNDLE_ID=app.tuck.prototype

COPYRIGHT_HOLDER="Miller Roberts"
COPYRIGHT="© 2026 $COPYRIGHT_HOLDER"

# Where Tuck points people: About's links. Support/Info.plist holds placeholders on tuck.example for the
# ones left empty, and scripts/release.sh refuses a signed release until all but SUPPORT_URL (an optional
# help page; support is by email) are set. Tuck never opens these itself: only when someone clicks one.
WEBSITE_URL=https://lineapps.vercel.app/tuck/
SUPPORT_URL=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
EULA_URL=
