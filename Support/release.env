# Tuck's identity for builds, read by scripts/build-app.sh and scripts/release.sh. This is the one place
# it is set: both scripts stamp it on the bundle's copy of Info.plist, so local and release builds match.
# Support/Info.plist carries the same values only so it is a complete plist on its own; every build
# overwrites them from here. Shell syntax: the scripts source this file.

# The bundle ID, on my own domain, as the other Line Apps have theirs (com.millerroberts.Glow,
# com.millerroberts.Pulse). Tuck was app.tuck.prototype until 2026-11-19. Changing it gives Tuck a new
# identity: anyone already running Tuck has to allow it in Accessibility and turn Open at login on again,
# because macOS keys both to the app's identity. Settings carry over from app.tuck.prototype at the first
# launch under this ID (SettingsMigration), and the library in ~/Library/Application Support/Tuck is
# named after the app, so it carries over too. scripts/release.sh still refuses a signed build while
# this contains "prototype". See docs/release.md.
BUNDLE_ID=com.millerroberts.Tuck

COPYRIGHT_HOLDER="Miller Roberts"
COPYRIGHT="© 2026 $COPYRIGHT_HOLDER"

# Where Tuck points people: About's links. Support/Info.plist holds placeholders on tuck.example for the
# website, privacy policy and EULA, kept when one is left empty here. scripts/release.sh refuses a signed
# release until those three are set, and SUPPORT_EMAIL or SUPPORT_URL (either will do). About's Support
# link shows the email when there is one, otherwise the support page's host. Tuck never opens these
# itself: only when someone clicks one.
WEBSITE_URL=https://lineapps.vercel.app/tuck/
SUPPORT_URL=https://github.com/millerroberts180/tuck/issues
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=https://github.com/millerroberts180/tuck/blob/main/docs/legal/privacy-policy.md
EULA_URL=https://github.com/millerroberts180/tuck/blob/main/docs/legal/EULA.txt
